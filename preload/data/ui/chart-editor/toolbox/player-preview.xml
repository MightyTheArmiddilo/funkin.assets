<?xml version="1.0" encoding="utf-8"?>
<collapsible-dialog id="toolboxPlayerPreview" title="Player Preview">
    <vbox width="100%" height="100%">
        <grid columns="2">
            <label text="Scale" />
            <number-stepper id="charPreviewScale" pos="0.5" step="0.1" tooltip="The scale of the player." />
            <label text="X" />
            <number-stepper id="charPreviewX" pos="0" step="1" tooltip="The X position of the player." />
            <label text="Y" />
            <number-stepper id="charPreviewY" pos="0" step="1" tooltip="The Y position of the player." />
        </grid>
        <character-player id="charPlayer" paddingLeft="10" paddingTop="10" paddingRight="10" paddingBottom="10" />
    </vbox>
</collapsible-dialog>
